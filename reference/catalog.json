      ]
    },
    {
      "id": "authority",
      "title": "Autorité et évolution",
      "summary": "Règles de propriété et de mutation des compositions.",
      "authority": "Frontière de modification.",
      "owns": [
        "admission",
        "traçabilité"
      ],
      "doesNotOwn": [
        "effet runtime"
      ],
      "workflow": [
        "Proposer",
        "Qualifier",
        "Engager"
      ],
      "sources": [
