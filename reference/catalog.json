{
  "schemaVersion": "1.0.0",
  "package": "@konitif/composition",
  "intent": "Build compositions without transferring their authority to the runtime.",
  "clusters": [
    {
      "id": "model",
      "title": "Composition model",
      "summary": "Canonical forms for plans, steps, and dependencies.",
      "authority": "Authored composition contracts.",
      "owns": [
        "logical structure",
        "relationships"
      ],
      "doesNotOwn": [
        "execution",
        "projection"
      ],
      "workflow": [
        "Declare",
        "Connect",
        "Validate"
      ],
      "sources": [
        "model.ts"
      ]
    },
    {
      "id": "authority",
      "title": "Authority and evolution",
      "summary": "Ownership and mutation rules for compositions.",
      "authority": "Modification boundary.",
      "owns": [
        "admission",
        "traceability"
      ],
      "doesNotOwn": [
        "runtime effect"
      ],
      "workflow": [
        "Propose",
        "Qualify",
        "Commit"
      ],
      "sources": [
        "authority.ts"
      ]
    },
    {
      "id": "construction",
      "title": "Construction",
      "summary": "Pure helpers for assembling canonical forms.",
      "authority": "Transformation without hidden state.",
      "owns": [
        "deterministic construction"
      ],
      "doesNotOwn": [
        "persistence"
      ],
      "workflow": [
        "Receive",
        "Build",
        "Return"
      ],
      "sources": [
        "helpers.ts"
      ]
    }
  ]
}
