{
  "schemaVersion": "1.0.0",
  "package": "@konitif/composition",
  "diagrams": [
    {
      "id": "composition-admission",
      "title": "Build and admit a composition",
      "kind": "lifecycle",
      "summary": "A composition remains authored until its structure has been validated and admitted for execution.",
      "nodes": [
        {
          "id": "need",
          "label": "Structured need",
          "description": "The intended effect and its constraints are known."
        },
        {
          "id": "draft",
          "label": "Draft composition",
          "description": "Steps and dependencies are assembled."
        },
        {
          "id": "validation",
          "label": "Validation",
          "description": "Structural invariants are checked."
        },
        {
          "id": "admission",
          "label": "Admission",
          "description": "An authority accepts the composition."
        },
        {
          "id": "plan",
          "label": "Available plan",
          "description": "The runtime can consume it without inventing its meaning.",
          "tone": "runtime"
        }
      ],
      "edges": [
        {
          "from": "need",
          "to": "draft"
        },
        {
          "from": "draft",
          "to": "validation"
        },
        {
          "from": "validation",
          "to": "admission"
        },
        {
          "from": "admission",
          "to": "plan"
        }
      ],
      "caption": "Validating a structure proves neither its execution nor its real effect."
    }
  ]
}
